{
  "entities": {
    "globalSettings": {
      "title": "Global Settings",
      "description": "Consolidated configuration settings for the app, including connected CMS sources and M3U8 parsers.",
      "type": "object",
      "properties": {
        "cmsSources": {
          "type": "array",
          "description": "List of connected CMS sources"
        },
        "m3u8Parsers": {
          "type": "array",
          "description": "List of physical video parsers/decoders"
        },
        "rules": {
          "type": "object",
          "description": "Unified scraping mapping rules"
        },
        "selectedCmsId": {
          "type": "string"
        },
        "selectedParserId": {
          "type": "string"
        }
      },
      "required": ["cmsSources", "m3u8Parsers", "rules", "selectedCmsId", "selectedParserId"]
    }
  },
  "firestore": {
    "/settings/{settingsId}": {
      "schema": "globalSettings",
      "description": "Core configuration settings for the video aggregator application."
    }
  }
}
